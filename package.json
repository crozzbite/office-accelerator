{
  "name": "office-accelerator",
  "version": "0.1.0",
  "private": true,
  "description": "IaC-like accelerator: pack-free Office* manifests for VS Code Copilot / Cursor (Scope B)",
  "type": "module",
  "scripts": {
    "scaffold": "bun run src/scaffold.ts",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "promote:neutral": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/promote-legion-neutral.ps1",
    "smoke:neutral": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/smoke-offices.ps1"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8.20.0",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
