{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "office-accelerator://schemas/brief/v1",
  "title": "FacadeToPmoBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "constraints", "forbidden_capabilities"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "change_id": { "type": "string", "minLength": 1 },
    "handoff_notes": { "type": "string" }
  }
}
